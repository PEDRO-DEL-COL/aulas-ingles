# Copie este arquivo para .env e preencha os valores.
# IMPORTANTE: variáveis VITE_* ficam expostas no navegador (bundle público).
# Coloque aqui SOMENTE a chave "anon" pública do Supabase.
# NUNCA use a chave "service_role" (nem qualquer segredo) neste projeto front-end.

# URL do projeto Supabase (Settings > API)
VITE_SUPABASE_URL=
# Chave anon pública do Supabase (Settings > API)
VITE_SUPABASE_ANON_KEY=
# Número do WhatsApp da professora, só dígitos, com código do país e DDD
VITE_WHATSAPP_NUMBER=5511999999999
